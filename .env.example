# ============================================================
# PPT-TTS-Project 配置文件
# ============================================================

# LLM 模式: local (本地SGlang) 或 api (MiniMax)
LLM_MODE=api

# 本地SGlang配置
LOCAL_LLM_URL=http://localhost:30000/v1
LOCAL_LLM_MODEL=Qwen3.5-9B
LOCAL_LLM_API_KEY=your-api-key-here

# MiniMax API 配置 (Anthropic兼容)
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_MODEL=MiniMax-M2.7

# TTS 配置
TTS_MODE=cosyvoice  # cosyvoice (本地) 或 edge (联网)

# CosyVoice 配置
COSYVOICE_SPEAKER=ChineseFemale
COSYVOICE_MODE=sft

# Edge TTS 配置
EDGE_VOICE=zh-CN-XiaoxiaoNeural

# ============================================================
# ppt-master 增强模式配置 (集成原生形状PPTX生成)
# ============================================================

# 是否启用ppt-master增强模式
ENABLE_PPT_MASTER=true

# 是否启用动画效果
PPT_MASTER_ANIMATIONS=true

# 是否启用页面过渡
PPT_MASTER_TRANSITIONS=true

# 风格选项: modern (现代) 或 classic (经典)
PPT_MASTER_STYLE=modern

# ============================================================
# PPT 格式自动调整配置
# ============================================================

# 是否启用自动格式调整（封面/提纲/内容页字体、颜色、对齐等）
ENABLE_PPT_FORMAT=true
